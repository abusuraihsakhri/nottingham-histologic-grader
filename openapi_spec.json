{
  "openapi": "3.1.0",
  "info": {
    "title": "Nottingham Histologic Grader API",
    "version": "3.1.0",
    "description": "Deterministic Nottingham grading plus a legacy synthetic demonstration API. Use de-identified educational inputs only."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Health metadata"
          }
        }
      }
    },
    "/api/grade": {
      "post": {
        "summary": "Grade three pre-assigned morphologic component scores",
        "description": "Each input must be an integer 1-3. The mitotic component score must already account for microscope field area.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "v1": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3,
                    "description": "Tubule formation"
                  },
                  "v2": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3,
                    "description": "Nuclear pleomorphism"
                  },
                  "v3": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3,
                    "description": "Calibrated mitotic component score"
                  }
                },
                "required": [
                  "v1",
                  "v2",
                  "v3"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Combined score 3–9 and grade 1–3"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy synthetic audit demo",
        "description": "Not a histologic grading or patient-care endpoint",
        "responses": {
          "200": {
            "description": "Synthetic audit dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy deterministic mock response",
        "responses": {
          "200": {
            "description": "Mock text"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-process synthetic audit demonstration log",
        "responses": {
          "200": {
            "description": "Audit chain metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON demonstration counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    }
  }
}
